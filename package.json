{
  "name": "dsh-paper-mode",
  "version": "1.2.0",
  "type": "module",
  "description": "DeepSeek Harness agent preset for academic paper writing: topic framing, literature review, structure and argument, language editing, citation practice, LaTeX builds, and submission review.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revive/dsh-paper-mode.git"
  },
  "homepage": "https://github.com/revive/dsh-paper-mode#readme",
  "bugs": {
    "url": "https://github.com/revive/dsh-paper-mode/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "academic-writing",
    "paper",
    "thesis",
    "dissertation",
    "latex",
    "xelatex",
    "bibtex",
    "biblatex",
    "literature-review",
    "citation",
    "research-writing",
    "ai-agent"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./*": "./*"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.en.md",
    "docs/DETAIL.zh.md",
    "docs/DEPENDENCIES.md",
    "docs/PROMPT-LANGUAGE.md",
    "skills",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-bundle.mjs",
    "pack": "pnpm pack"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "semver": "^7.6.3"
  },
  "packageManager": "pnpm@11.5.3"
}
